{
  "manifest_version": 3,
  "name": "JSON Formatter Hub",
  "version": "2.0.0",
  "description": "In-browser JSON tree viewer, formatter, search, and quick link to JSON Formatter Hub advanced tools.",
  "icons": {
    "16":  "icons/icon16.png",
    "32":  "icons/icon32.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["utils.js", "viewer.js", "content.js"],
      "css": ["style.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
